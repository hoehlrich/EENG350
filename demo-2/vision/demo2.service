# EENG350 Demo 2 - Starts demo2.py when the Pi boots, so the robot runs
# with nothing plugged into it.
#
# CHANGE the user and the two paths below to match the Pi, then:
#
#     sudo cp demo2.service /etc/systemd/system/
#     sudo systemctl daemon-reload
#     sudo systemctl enable --now demo2      start now and at every boot
#
#     systemctl status demo2                 is it running?
#     journalctl -u demo2 -f                 what it prints (frame rate, readings)
#     sudo systemctl stop demo2              stop it, e.g. to run demo2.py by hand
#     sudo systemctl disable demo2           don't start at boot any more
#
# Only one program can use the camera, so stop the service before running
# demo2.py (or Demo 1's script) yourself.

[Unit]
Description=EENG350 Demo 2 vision (marker and arrow to the Arduino)

[Service]
User=pi
WorkingDirectory=/home/pi/project/demo-2/vision
ExecStart=/usr/bin/python3 /home/pi/project/demo-2/vision/demo2.py
# Print straight to the journal instead of holding lines back
Environment=PYTHONUNBUFFERED=1
# If it ever exits (camera unplugged, a crash), start it again
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
